bool isPalindrome(string s) {
      string og,rev;
      int start=0, end=s.size()-1;
      for(int i=0;i<s.size();i++){
          if(isalpha(s[start])){
                og+=tolower(s[start]);
          }
          if(isdigit(s[start])){
                og+=(char)s[end];
          }
          if(isalpha(s[end])){
            rev+=tolower(s[end]);
          }
          if(isdigit(s[end])){
                rev+=(char)s[end];
          }
          start++;
          end--;
      }
      if(og.compare(rev) != 0){
        return false;
      }
      return true;

}
